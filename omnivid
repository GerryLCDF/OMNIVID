def is_playlist(url):
    return bool(re.search(r'[?&]list=|playlist', url, re.IGNORECASE))

def clean_url(url):
    url = url.strip()
    url = re.sub(r'^[`"\']|[`"\']$', '', url)
    url = re.sub(r'\s+.*$', '', url)
    return url

def fetch_playlist(url):
    try:
        r = subprocess.run(
            ["yt-dlp", "--flat-playlist", "-J", "--no-warnings", "--ignore-errors", url],
            capture_output=True, text=True, timeout=60
        )
        if r.returncode != 0 and not r.stdout.strip():
            err = r.stderr.strip().split("\n")[-1] if r.stderr.strip() else "Error desconocido"
            console.print(f"\n  [bold red]yt-dlp error:[/] {err}")
            return None
        raw = r.stdout.strip()
        if not raw:
            console.print("\n  [bold red]X[/] [red]yt-dlp no devolvio datos[/]")
            return None
        data = __import__("json").loads(raw)
        entries = data.get("entries", [])
        if not entries:
            console.print("\n  [bold red]X[/] [red]La playlist esta vacia o no se pudo leer[/]")
            return None
        videos = []
        unavailable = 0
        for i, e in enumerate(entries, 1):
            vid_id = e.get("id", "")
            title = e.get("title", "Sin titulo")
            available = True
            if not vid_id or vid_id == "NA":
                available = False
            elif title in ("Private video", "Deleted video", "[Deleted video]", "[Private video]"):
                available = False
            if not available:
                unavailable += 1
            videos.append({
                "index": i,
                "id": vid_id,
                "title": title,
                "url": f"https://www.youtube.com/watch?v={vid_id}" if vid_id and vid_id != "NA" else "",
                "duration": format_duration(e.get("duration")),
                "available": available,
            })
        return {
            "title": data.get("title", "Playlist desconocida"),
            "uploader": data.get("uploader", data.get("channel", "Desconocido")),
            "count": len(videos),
            "available_count": len(videos) - unavailable,
            "unavailable_count": unavailable,
            "videos": videos,
        }
    except subprocess.TimeoutExpired:
        console.print("\n  [bold red]X[/] [red]Timeout al obtener playlist (60s)[/]")
        return None
    except __import__("json").JSONDecodeError as e:
        console.print(f"\n  [bold red]X[/] [red]Error al leer JSON: {e}[/]")
        return None
    except Exception as e:
        console.print(f"\n  [bold red]X[/] [red]Error inesperado: {type(e).__name__}: {e}[/]")
        return None

def format_duration(secs):
    if not secs:
        return "??:??"
    secs = int(secs)
    h = secs // 3600
    m = (secs % 3600) // 60
    s = secs % 60
    if h > 0:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"

