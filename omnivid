def parse_selection(text, max_val):
    text = text.strip().lower()
    if text in ("all", "todas", "todo", "a", "*"):
        return list(range(1, max_val + 1))
    if text in ("none", "nada", "n", "ninguna", "0"):
        return []
    selected = set()
    for part in text.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            try:
                start, end = part.split("-", 1)
                start = int(start.strip())
                end = int(end.strip())
                for i in range(start, min(end, max_val) + 1):
                    if 1 <= i <= max_val:
                        selected.add(i)
            except ValueError:
                continue
        else:
            try:
                num = int(part)
                if 1 <= num <= max_val:
                    selected.add(num)
            except ValueError:
                continue
    return sorted(selected)

