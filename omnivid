    if len(sys.argv) > 1:
        link = clean_url(sys.argv[1])
        if not re.search(r'(youtube\.com|youtu\.be)', link):
            console.print("[bold red]X[/] [red]URL no valida de YouTube[/]")
            sys.exit(1)
        mode = "1" if "--audio" in sys.argv or "-a" in sys.argv else "2"
