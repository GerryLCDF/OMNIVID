        except:
            pass
    return "brave"

def make_cookie_file():
    try:
        import browser_cookie3
        cj = browser_cookie3.brave(domain_name=".youtube.com")
        tmp = tempfile.NamedTemporaryFile(suffix=".txt", delete=False, prefix="omnivid-cookies-")
        with open(tmp.name, "w") as f:
            f.write("# Netscape HTTP Cookie File\n\n")
            for c in cj:
                domain = c.domain
                flag = "TRUE" if domain.startswith(".") else "FALSE"
                secure = "TRUE" if c.secure else "FALSE"
                exp = int(c.expires) if c.expires else 0
                f.write(f"{domain}\t{flag}\t{c.path}\t{secure}\t{exp}\t{c.name}\t{c.value}\n")
        if os.path.getsize(tmp.name) < 50:
            os.unlink(tmp.name)
            return None
        return tmp.name
    except Exception as e:
        return None

def run_ytdlp(args, tag, timeout=600):
    """Ejecuta yt-dlp mostrando barra de progreso en vivo. Devuelve (returncode, lines)."""
    lines = []
    with Progress(
        ProgressText("[bold bright_white]{task.description}"),
        BarColumn(),
        TaskProgressColumn(),
        TimeRemainingColumn(),
        console=console,
    ) as progress:
        task = progress.add_task(tag, total=100)
        p = subprocess.Popen(
            args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
        try:
            while True:
                ready, _, _ = select.select([p.stdout], [], [], 0.5)
                if not ready:
                    if p.poll() is not None:
                        break
                    continue
                line = p.stdout.readline()
                if not line:
                    break
                line = line.rstrip("\n")
                lines.append(line)
                m = re.search(r"\[download\]\s+([\d.]+)%", line)
                if m:
                    progress.update(task, completed=float(m.group(1)))
                dm = re.search(r"Destination:\s+(.+)", line)
                if dm:
                    fname = os.path.basename(dm.group(1).strip())
                    progress.update(task, description=fname)
                mm = re.search(r"Merging formats into\s+[\"']([^\"']+)[\"']", line)
                if mm:
                    progress.update(task, description=os.path.basename(mm.group(1)))
            p.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
            raise
    return p.returncode, lines

def run_download(link, mode):
    is_audio = mode == "1"
    outtmpl = os.path.join(WORKDIR, "%(playlist_index)s - %(title)s.%(ext)s")

    def build_args(cookies=None):
        args = ["yt-dlp", "-o", outtmpl, "--no-warnings", "--newline", link]
        if cookies:
            args += ["--cookies", cookies]
        if is_audio:
            args += ["-x", "--audio-format", "mp3", "--audio-quality", "320"]
        else:
            args += ["-f", "bv*+ba/b", "--merge-output-format", "mp4"]
        return args

    tag = "[bold green]Audio[/]" if is_audio else "[bold green]Video[/]"
    r = None
    lines = []
    cookie_file = None
    try:
        r, lines = run_ytdlp(build_args(), f"Descargando {tag}")

        if r != 0:
            cookie_file = make_cookie_file()
            if cookie_file:
                r, lines = run_ytdlp(build_args(cookie_file), f"Reintentando {tag}")

        if r != 0:
            err = lines[-1] if lines and lines[-1].strip() else "Error desconocido"
            console.print(f"\n  [bold red]X[/] [red]{err}[/]")
            return None
    except subprocess.TimeoutExpired:
        console.print("\n  [bold red]X[/] [red]Timeout - la descarga tardo mucho[/]")
        return None
    except Exception as e:
        console.print(f"\n  [bold red]X[/] [red]{str(e)}[/]")
        return None
    finally:
        if cookie_file and os.path.exists(cookie_file):
            os.unlink(cookie_file)

    fname = "archivo descargado"
    for line in reversed(lines):
        if "Destination:" in line:
            fname = line.split("Destination:")[-1].strip()
            break
        elif "[download]" in line and "%" in line and "100%" in line:
            parts = line.split()
            for p in parts:
                if p.endswith(('.mp4', '.mp3', '.webm', '.mkv', '.m4a')):
                    fname = p
                    break

    console.print(f"\n  [bold green]:)[/] [bold bright_white]{fname}[/]")
    return fname

def download_single(link, mode):
    outtmpl = os.path.join(WORKDIR, "%(title)s.%(ext)s")
    is_audio = mode == "1"
    tag = "[bold green]Audio[/]" if is_audio else "[bold green]Video[/]"

    def build_args(cookies=None):
        args = ["yt-dlp", "-o", outtmpl, "--no-playlist", "--no-warnings", "--newline", link]
        if cookies:
            args += ["--cookies", cookies]
        if is_audio:
            args += ["-x", "--audio-format", "mp3", "--audio-quality", "320"]
        else:
            args += ["-f", "bv*+ba/b", "--merge-output-format", "mp4"]
        return args

    r = None
    lines = []
    cookie_file = None
    try:
        r, lines = run_ytdlp(build_args(), f"Descargando {tag}")

        if r != 0:
            cookie_file = make_cookie_file()
            if cookie_file:
                r, lines = run_ytdlp(build_args(cookie_file), f"Reintentando {tag}")

        if r != 0:
            err = lines[-1] if lines and lines[-1].strip() else "Error desconocido"
            console.print(f"\n  [bold red]X[/] [red]{err}[/]")
            return None
    except subprocess.TimeoutExpired:
        console.print("\n  [bold red]X[/] [red]Timeout - la descarga tardo mucho[/]")
        return None
    except Exception as e:
        console.print(f"\n  [bold red]X[/] [red]{str(e)}[/]")
        return None
    finally:
        if cookie_file and os.path.exists(cookie_file):
            os.unlink(cookie_file)

    fname = "archivo descargado"
    for line in lines:
        if "Merging formats into" in line:
            fname = line.split('"')[-2] if '"' in line else line.split("into")[-1].strip()
            break
        elif "Destination:" in line:
            candidate = line.split("Destination:")[-1].strip()
            if not candidate.endswith(('.webm', '.m4a', '.opus', '.part')):
                fname = candidate
    if fname == "archivo descargado":
        for line in reversed(lines):
            if "[download]" in line and "%" in line:
                parts = line.split()
                for p in parts:
                    if p.endswith(('.mp4', '.mp3', '.webm', '.mkv', '.m4a')) and '.part' not in p:
                        fname = p
                        break
                if fname != "archivo descargado":
                    break

    console.print(f"\n  [bold green]:)[/] [bold bright_white]{fname}[/]")
    return fname

def handle_playlist(url, history):
    clear()
    console.print()
    console.print(render_banner())
    console.print()
    console.print(Panel(
        Align.center(Text("Obteniendo informacion de la playlist...", style="italic bright_white")),
        title="[bold bright_magenta]Playlist[/]", border_style="bright_magenta", padding=(0, 2),
    ))
    console.print()

    playlist = fetch_playlist(url)
    if not playlist:
        console.print("  [bold red]X[/] [red]No se pudo obtener la playlist[/]")
        input("\n  Presiona ENTER para continuar...")
        return

    clear()
    console.print()
    console.print(render_banner())
    console.print()
    console.print(render_playlist(playlist))
    console.print()
    console.print(render_selection_prompt(playlist["count"], playlist.get("unavailable_count", 0)))
    console.print()

    try:
        sel = input("  \033[32m\033[1m>\033[0m \033[37m\033[1m").strip()
        print("\033[0m", end="")
    except (EOFError, KeyboardInterrupt):
        return

    indices = parse_selection(sel, playlist["count"])
    if not indices:
        console.print("\n  [bold yellow]![/] [yellow]Ningun video seleccionado[/]")
        input("\n  Presiona ENTER para continuar...")
        return

    selected = []
    skipped = []
    for v in playlist["videos"]:
        if v["index"] in indices:
            if v["available"] and v["url"]:
                selected.append(v)
            else:
                skipped.append(v)

    if not selected:
        console.print("\n  [bold yellow]![/] [yellow]Ningun video disponible para descargar[/]")
        input("\n  Presiona ENTER para continuar...")
        return

    clear()
    console.print()
    console.print(render_banner())
    console.print()
    console.print(Panel(
        Align.center(Text(
            f"{len(selected)} videos para descargar" + (f"  [dim]({len(skipped)} omitidos)[/]" if skipped else ""),
            style="italic bright_white")),
        title="[bold bright_cyan]Formato[/]", border_style="bright_cyan", padding=(0, 2),
    ))
    console.print()

    try:
        fmt = input("  \033[33m\033[1m[1] Audio  [2] Video\033[0m \033[37m\033[1m>\033[0m \033[37m\033[1m").strip()
        print("\033[0m", end="")
    except (EOFError, KeyboardInterrupt):
        return

    global_mode = "1" if fmt in ("1", "a", "audio") else "2"

    clear()
    console.print()
    console.print(render_banner())
    console.print()

    if skipped:
        console.print(Panel(
            Align.center(Text(
                "Videos omitidos (no disponibles): " + ", ".join(f"#{s['index']}" for s in skipped),
                style="dim red")),
            title="[bold red]Omitidos[/]", border_style="red", padding=(0, 2),
        ))
        console.print()

    ok = 0
    fail = 0
    for v in selected:
        title = v["title"] or "[No disponible]"
        if len(title) > 50:
            title = title[:47] + "..."

        console.print(f"  [bold bright_white]{v['index']}.[/] {title}")

        fname = run_download(v["url"], global_mode)
        if fname:
            history.append({
                "file": fname,
                "mode": "audio" if global_mode == "1" else "video",
                "time": datetime.now().strftime("%H:%M:%S"),
            })
            ok += 1
        else:
            fail += 1
        console.print()

    console.print(Panel(
        Align.center(Text(
            f"[bold green]{ok}[/] descargados  |  [bold red]{fail}[/] fallidos" +
            (f"  |  [dim]{len(skipped)} omitidos[/]" if skipped else ""),
            style="bright_white")),
        title="[bold bright_green]Resultados[/]", border_style="bright_green", padding=(0, 2),
    ))
    input("\n  Presiona ENTER para continuar...")

